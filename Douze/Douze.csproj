<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>douze</AssemblyName>
    <RootNamespace>Douze</RootNamespace>

    <!-- Native AOT RID-specific packages are produced explicitly in CI: dotnet pack -r <rid> -p:PackTool=true -->
    <IsPackable>false</IsPackable>
    <IsPackable Condition="'$(PackTool)' == 'true'">true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <IncludeSymbols>false</IncludeSymbols>
    <PackageId>Douze</PackageId>
    <ToolCommandName>douze</ToolCommandName>
    <Title>Douze static site generator</Title>
    <Description>Stupidly simple, blazing fast static site generator.</Description>
    <PackageTags>static-site-generator;liquid;markdown;cli;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <PublishAot>true</PublishAot>
    <!-- LibraryImport (ProcessTree) generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The tool has no use for its XML documentation, and the .NET 11 SDK's native AOT publish doesn't copy it to bin. -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <!-- A build is a batch job: background GC only throttles the allocating threads (bench/README.md, .NET 11). -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ToolPackageRuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64;any</ToolPackageRuntimeIdentifiers>

    <!-- Fluid's reflection based member access and json filter are covered: see DouzeJsonContext. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <TrimmerSingleWarn>true</TrimmerSingleWarn>
    <NoWarn>$(NoWarn);IL2026;IL2067;IL2070;IL2075;IL3050;IL2104;IL3053</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Douze.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- douze-worker.mjs is a placeholder until phase 3 fills it in. -->
    <EmbeddedResource Include="Workflow\Commands\douze-worker.mjs" LogicalName="douze-worker.mjs" />
    <EmbeddedResource Include="Tracing\timeline.html" LogicalName="timeline.html" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Fluid.Core" />
    <PackageReference Include="SharpYaml" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="ZString" />
  </ItemGroup>
</Project>
