<Project Sdk="Microsoft.NET.Sdk">

  <!-- Native AOT builds of douze (publish, and the RID-specific tool packages) use the Satori GC: an experimental third
       party build of the runtime, faster and using more memory on large sites (bench/README.md, finding 9); its version
       is in global.json. -p:UseSatoriGC=false builds with the standard GC. Builds, tests and the CoreCLR fallback
       package (PublishAot=false) use the standard runtime. -->
  <PropertyGroup>
    <UseSatoriGC Condition="'$(UseSatoriGC)' == '' and '$(PublishAot)' != 'false' and ('$(_IsPublishing)' == 'true' or ('$(PackTool)' == 'true' and '$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'any'))">true</UseSatoriGC>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="PublishWithSatoriGC" Condition="'$(UseSatoriGC)' == 'true'" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>douze</AssemblyName>
    <RootNamespace>Douze</RootNamespace>

    <!-- Native AOT RID-specific packages are produced explicitly in CI: dotnet pack -r <rid> -p:PackTool=true -->
    <IsPackable>false</IsPackable>
    <IsPackable Condition="'$(PackTool)' == 'true'">true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <IncludeSymbols>false</IncludeSymbols>
    <!-- The symbols of the binary (douze.dSYM, douze.dbg, douze.pdb: several times its size) stay out of the packages
         and of the release archives made from them; a dotnet publish keeps them. -->
    <CopyOutputSymbolsToPublishDirectory Condition="'$(PackTool)' == 'true'">false</CopyOutputSymbolsToPublishDirectory>
    <PackageId>Douze</PackageId>
    <ToolCommandName>douze</ToolCommandName>
    <Title>Douze static site generator</Title>
    <Description>Stupidly simple, blazing fast static site generator.</Description>
    <PackageTags>static-site-generator;liquid;markdown;cli;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <PublishAot>true</PublishAot>
    <!-- LibraryImport (ProcessTree) generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The tool has no use for its XML documentation, and the .NET 11 SDK's native AOT publish doesn't copy it to bin. -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <!-- With the standard GC: a build is a batch job, background GC only throttles the allocating threads (bench/README.md, .NET 11). -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ToolPackageRuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64;any</ToolPackageRuntimeIdentifiers>

    <!-- Fluid's reflection based member access and json filter are covered: see DouzeJsonContext. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <TrimmerSingleWarn>true</TrimmerSingleWarn>
    <NoWarn>$(NoWarn);IL2026;IL2067;IL2070;IL2075;IL3050;IL2104;IL3053</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Douze.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- douze-worker.mjs is a placeholder until phase 3 fills it in. -->
    <EmbeddedResource Include="Workflow\Commands\douze-worker.mjs" LogicalName="douze-worker.mjs" />
    <EmbeddedResource Include="Tracing\timeline.html" LogicalName="timeline.html" />
    <EmbeddedResource Include="Workflow\Watch\livereload.js" LogicalName="livereload.js" />
    <!-- The grammars and themes of the highlight step (scripts/update-textmate.cs) and its default templates. -->
    <EmbeddedResource Include="Highlighting\textmate.zip" LogicalName="textmate.zip" />
    <EmbeddedResource Include="Highlighting\Templates\*.liquid" LogicalName="highlight/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="NetVips" />
    <PackageReference Include="Fluid.Core" />
    <PackageReference Include="SharpYaml" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="Tint" />
    <PackageReference Include="Tint.Grammars" />
    <!-- The VS Code grammar files the kernel grammars are generated from (DouzeKernelGrammars, below): nothing ships. -->
    <PackageReference Include="Tint.Grammars.Sources" PrivateAssets="all" />
    <PackageReference Include="ZString" />
  </ItemGroup>

  <!-- Grammars compiled to regex kernels by Tint's source generator (CodeTokenizer registers them before the grammars
       of Tint.Grammars and textmate.zip): a list among csharp, typescript, html and json, none by default. Each one
       makes the tool larger (about 1 MB for C#) and its build slower, for faster tokenizing of that language:
       dotnet publish Douze -p:DouzeKernelGrammars="csharp;typescript". -->
  <PropertyGroup>
    <_DouzeKernelGrammars>;$(DouzeKernelGrammars.Replace(' ', '').ToLowerInvariant());</_DouzeKernelGrammars>
    <TintGrammarsClass>Douze.Highlighting.KernelGrammars</TintGrammarsClass>
  </PropertyGroup>

  <ItemGroup>
    <TintGrammar Include="@(TintGrammarsSourcesAll->WithMetadataValue('LanguageId', 'csharp'))" Kernels="true" Namespace="Douze.Highlighting" Name="KernelCSharpGrammar" Condition="$(_DouzeKernelGrammars.Contains(';csharp;'))" />
    <TintGrammar Include="@(TintGrammarsSourcesAll->WithMetadataValue('LanguageId', 'typescript'))" Kernels="true" Namespace="Douze.Highlighting" Name="KernelTypeScriptGrammar" Condition="$(_DouzeKernelGrammars.Contains(';typescript;'))" />
    <TintGrammar Include="@(TintGrammarsSourcesAll->WithMetadataValue('LanguageId', 'html'))" Kernels="true" Namespace="Douze.Highlighting" Name="KernelHtmlGrammar" Condition="$(_DouzeKernelGrammars.Contains(';html;'))" />
    <TintGrammar Include="@(TintGrammarsSourcesAll->WithMetadataValue('LanguageId', 'json'))" Kernels="true" Namespace="Douze.Highlighting" Name="KernelJsonGrammar" Condition="$(_DouzeKernelGrammars.Contains(';json;'))" />
  </ItemGroup>

  <!-- libvips, the native library of the image features (NetVips, loaded by its module initializer at process start):
       the package of the runtime identifier being built, which puts the library next to the binary of a native AOT
       publish and in the RID-specific tool packages; for builds and tests without a runtime identifier, the package of
       the SDK's. The CoreCLR fallback package ('any') carries the library of every runtime identifier of the tool
       packages under runtimes/<rid>/native, which the host picks for the machine; elsewhere the image features report
       how to get one. Items are evaluated after every property, so RuntimeIdentifier is final here, including the one
       the Satori import sets below. -->
  <PropertyGroup>
    <_NetVipsNativeRids>;win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64;</_NetVipsNativeRids>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetVips.Native.$(RuntimeIdentifier)" Condition="'$(RuntimeIdentifier)' != '' and $(_NetVipsNativeRids.Contains(';$(RuntimeIdentifier);'))" />
    <PackageReference Include="NetVips.Native.$(NETCoreSdkRuntimeIdentifier)" Condition="'$(RuntimeIdentifier)' == '' and '$(PackTool)' != 'true' and $(_NetVipsNativeRids.Contains(';$(NETCoreSdkRuntimeIdentifier);'))" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'any'">
    <PackageReference Include="NetVips.Native.win-x64" />
    <PackageReference Include="NetVips.Native.win-arm64" />
    <PackageReference Include="NetVips.Native.linux-x64" />
    <PackageReference Include="NetVips.Native.linux-arm64" />
    <PackageReference Include="NetVips.Native.osx-x64" />
    <PackageReference Include="NetVips.Native.osx-arm64" />
  </ItemGroup>

  <PropertyGroup Condition="'$(UseSatoriGC)' == 'true'">
    <!-- Satori replaces the runtime packs of a runtime identifier, which a native AOT publish otherwise infers later. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
  </PropertyGroup>

  <Import Project="Sdk.targets" Sdk="PublishWithSatoriGC" Condition="'$(UseSatoriGC)' == 'true'" />
</Project>
