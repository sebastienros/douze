# Pinned inputs of the comparison. run.sh reads this file and passes the values to docker build.

# The benchmark: https://github.com/zachleat/bench-framework-markdown (Markdown samples and original scripts)
BENCH_REPO=https://github.com/zachleat/bench-framework-markdown.git
BENCH_COMMIT=fbda1c16fdf9d06bc2a3d785207a05c5c7f3b148

# Base images
NODE_IMAGE=node:24.22.1-trixie-slim
RUBY_IMAGE=ruby:3.4.11-slim-trixie
DEBIAN_IMAGE=debian:trixie-slim
DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:11.0.100-rc.2
DOTNET_RUNTIME_DEPS_IMAGE=mcr.microsoft.com/dotnet/runtime-deps:11.0.0-rc.2

# Generators
HUGO_VERSION=0.168.0
ELEVENTY_VERSION=3.1.7
ELEVENTY_BASE_BLOG_COMMIT=cf0cc1f1b5972d9d7d06b9a0f0488e61839f3207
ASTRO_VERSION=7.4.0
JEKYLL_VERSION=4.4.1
MINIMA_VERSION=2.5.2

# Docs-heavy scenario (run-docs-heavy.sh), on top of the versions above
ELEVENTY_SYNTAXHIGHLIGHT_VERSION=5.0.2
MARKDOWN_IT_ANCHOR_VERSION=10.0.0
