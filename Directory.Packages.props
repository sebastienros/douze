<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Global Package References -->
    <!-- Douze -->
    <PackageVersion Include="Fluid.Core" Version="3.0.0" />
    <PackageVersion Include="Markdig" Version="1.6.0" />
    <PackageVersion Include="SharpYaml" Version="3.18.0" />
    <!-- Images: ImageSharp needs a Six Labors license key to build (sixlabors.lic, AGENTS.md) -->
    <PackageVersion Include="SixLabors.Fonts" Version="3.2.1" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="4.1.4" />
    <PackageVersion Include="SixLabors.ImageSharp.Drawing" Version="3.1.3" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="System.IO.Hashing" Version="11.0.0" />
    <PackageVersion Include="Tint" Version="0.3.0" />
    <PackageVersion Include="Tint.Grammars" Version="0.3.0" />
    <PackageVersion Include="ZString" Version="2.6.0" />
    <!-- Scripts (scripts/*.cs) -->
    <PackageVersion Include="NuGet.Versioning" Version="7.9.0" />
    <!-- Testing -->
    <PackageVersion Include="Spectre.Console.Testing" Version="0.57.2" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.3" />
  </ItemGroup>
</Project>
