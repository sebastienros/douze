<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Global Package References -->
    <GlobalPackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100-rc.3.26522.148" PrivateAssets="all" />
    <!-- Douze -->
    <PackageVersion Include="Fluid.Core" Version="3.0.0-preview-807" />
    <PackageVersion Include="Markdig" Version="1.5.0" />
    <PackageVersion Include="NetVips" Version="3.2.0" />
    <!-- libvips, one package per runtime identifier of the tool packages (Douze.csproj) -->
    <PackageVersion Include="NetVips.Native.linux-arm64" Version="8.18.7" />
    <PackageVersion Include="NetVips.Native.linux-x64" Version="8.18.7" />
    <PackageVersion Include="NetVips.Native.osx-arm64" Version="8.18.7" />
    <PackageVersion Include="NetVips.Native.osx-x64" Version="8.18.7" />
    <PackageVersion Include="NetVips.Native.win-arm64" Version="8.18.7" />
    <PackageVersion Include="NetVips.Native.win-x64" Version="8.18.7" />
    <PackageVersion Include="SharpYaml" Version="3.16.0" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="System.IO.Hashing" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Tint" Version="0.1.2" />
    <PackageVersion Include="Tint.Grammars" Version="0.1.2" />
    <PackageVersion Include="ZString" Version="2.6.0" />
    <!-- Scripts (scripts/*.cs) -->
    <PackageVersion Include="NuGet.Versioning" Version="7.9.0" />
    <!-- Image benchmark (bench/Douze.ImageBench), compared with NetVips -->
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.macOS" Version="4.153.1" />
    <PackageVersion Include="Svg.Skia" Version="5.2.3" />
    <!-- Testing -->
    <PackageVersion Include="Spectre.Console.Testing" Version="0.57.2" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.2" />
  </ItemGroup>
</Project>
