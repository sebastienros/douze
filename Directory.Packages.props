<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Global Package References -->
    <GlobalPackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100-rc.2.26504.105" PrivateAssets="all" />
    <!-- Douze -->
    <PackageVersion Include="Fluid.Core" Version="3.0.0-preview-781" />
    <PackageVersion Include="Markdig" Version="1.4.2" />
    <PackageVersion Include="NetVips" Version="3.2.0" />
    <!-- libvips, one package per runtime identifier of the tool packages (Douze.csproj) -->
    <PackageVersion Include="NetVips.Native.linux-arm64" Version="8.18.7" />
    <PackageVersion Include="NetVips.Native.linux-x64" Version="8.18.7" />
    <PackageVersion Include="NetVips.Native.osx-arm64" Version="8.18.7" />
    <PackageVersion Include="NetVips.Native.osx-x64" Version="8.18.7" />
    <PackageVersion Include="NetVips.Native.win-arm64" Version="8.18.7" />
    <PackageVersion Include="NetVips.Native.win-x64" Version="8.18.7" />
    <PackageVersion Include="SharpYaml" Version="3.16.0" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="System.IO.Hashing" Version="11.0.0-rc.2.26504.105" />
    <PackageVersion Include="ZString" Version="2.6.0" />
    <!-- Testing -->
    <PackageVersion Include="Spectre.Console.Testing" Version="0.57.2" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.2" />
  </ItemGroup>
</Project>
