    <PackageVersion Include="Markdig" Version="1.4.2" />
    <PackageVersion Include="SharpYaml" Version="3.16.0" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.13" />
    <PackageVersion Include="ZString" Version="2.6.0" />
    <!-- Testing -->
    <PackageVersion Include="Spectre.Console.Testing" Version="0.57.2" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.2" />
  </ItemGroup>
</Project>
