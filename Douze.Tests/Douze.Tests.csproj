<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Testing" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <!-- A grammar compiled to regex kernels by Tint's generator, as Douze's DouzeKernelGrammars builds compile them. -->
    <PackageReference Include="Tint" />
    <PackageReference Include="Tint.Grammars.Sources" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <TintGrammar Include="@(TintGrammarsSourcesAll->WithMetadataValue('LanguageId', 'json'))" Kernels="true" Namespace="Douze.Tests.Highlighting" Name="KernelJsonGrammar" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Douze\Douze.csproj" />
    <!-- Built before the tests, launched by the command step tests with 'dotnet <path to its dll>'; not referenced. -->
    <ProjectReference Include="..\Douze.Tests.FakeTool\Douze.Tests.FakeTool.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fixture sites and workflow files, copied next to the tests. -->
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
