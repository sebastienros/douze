<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- only use the feeds below -->
    <clear/>
    <add key="NuGet" value="https://api.nuget.org/v3/index.json" />
    <add key="Fluid" value="https://f.feedz.io/sebastienros/fluid/nuget/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="NuGet">
      <package pattern="*" />
    </packageSource>
    <!-- Fluid 3.0 previews -->
    <packageSource key="Fluid">
      <package pattern="Fluid.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
